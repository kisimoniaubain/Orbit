# ORBIT Environment Configuration

# Server
PORT=5000
NODE_ENV=development

# Database
MONGODB_URI=mongodb://127.0.0.1:27017/orbit

# Authentication
JWT_SECRET=orbit-jwt-secret-change-in-production
JWT_EXPIRES_IN=7d

# Application URLs
FRONTEND_URL=http://localhost:5173
ORBIT_APP_URL=http://localhost:5173

# Stripe Payments
STRIPE_SECRET_KEY=sk_test_YOUR_STRIPE_SECRET_KEY_HERE
STRIPE_PUBLIC_KEY=pk_test_YOUR_STRIPE_PUBLIC_KEY_HERE
STRIPE_WEBHOOK_SECRET=whsec_YOUR_STRIPE_WEBHOOK_SECRET_HERE
VITE_STRIPE_PUBLIC_KEY=pk_test_YOUR_STRIPE_PUBLIC_KEY_HERE

# Cloudflare
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token

# AWS CloudFront / S3
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=us-east-1
CLOUDFRONT_DISTRIBUTION_ID=your_cloudfront_distribution_id

# Google Analytics
VITE_GA_MEASUREMENT_ID=G-YOUR_GA_MEASUREMENT_ID

# Intercom
VITE_INTERCOM_APP_ID=your_intercom_app_id
